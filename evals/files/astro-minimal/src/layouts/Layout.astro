---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>{title} — Tischlerei Beispiel</title>
    <!-- Plausible, EU-hosted, cookieless -->
    <script defer data-domain="tischlerei-beispiel.de" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <slot />
    <footer>
      <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a>
    </footer>
  </body>
</html>
